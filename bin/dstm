#!/bin/sh
# dstm — DST Moon launcher (bash). Mirrors bin/dstm.cmd.
# Boots dsh with the dst-moon profile: OUR fork of dsh-tui aimed at a LOCAL
# model (llama.cpp, OpenAI-compatible) — see VENDORED.md and profile/.
#   --resume: feed the session id recorded by the TUI to DSH_TUI_RESUME_SESSION
# DST-Moon keeps its own state (~/.dst-moon) so it never shares settings,
# history or session logs with a sibling dsh-tui fork (DST-Comet, ~/.dsh-tui).
set -e
: "${NODE_ENV:=production}"
export NODE_ENV
# Session logs live under our own data dir unless the caller overrides.
: "${DSH_TUI_SESSION_ROOT:=$HOME/.dst-moon/sessions}"
export DSH_TUI_SESSION_ROOT
# Fork-isolation pin (same convention as the comet fork's launchers): the TUI
# also reads DSH_TUI_STATE_DIR, so even if a rebase restores the upstream
# ~/.dsh-tui default the state dir stays Moon-owned.
: "${DSH_TUI_STATE_DIR:=$HOME/.dst-moon}"
export DSH_TUI_STATE_DIR
# Ask the local server which aliases it is serving and pass them to the
# profile pipe-separated (DSH_LLAMA_MODELS): the llama-local route's model
# list is materialized from this at boot, so whatever start-*.bat is loaded
# is what Moon offers. Empty (server down) -> the profile's fallback alias.
DSH_LLAMA_MODELS=$(node -e '
const t = setTimeout(() => process.exit(0), 1500)
fetch("http://127.0.0.1:8080/v1/models").then(r => r.json()).then(j => {
  clearTimeout(t)
  console.log((j.data || []).map(m => m.id).filter(Boolean).join("|"))
  process.exit(0)
}).catch(() => { clearTimeout(t); process.exit(0) })
' 2>/dev/null)
export DSH_LLAMA_MODELS
# Per-alias context windows from the rig's start-*.bat launchers
# (--alias X + -c N): alias:ctx pipe pairs -> DSH_LLAMA_CTX, so the declared
# window follows the loaded model (bonsai 32k vs 262k others).
# DSH_LLAMA_BATS_DIR overrides the rig default; missing dir -> empty.
DSH_LLAMA_CTX=$(node -e '
const fs = require("node:fs"), p = require("node:path")
const dir = process.env.DSH_LLAMA_BATS_DIR || "C:/Code/Ai_Model"
const out = []
try {
  for (const f of fs.readdirSync(dir)) {
    if (!/^start-.*\.bat$/i.test(f)) continue
    const tk = fs.readFileSync(p.join(dir, f), "latin1").replace(/\r|\n/g, " ").split(/\s+/)
    const ai = tk.indexOf("--alias")
    let ci = tk.indexOf("--ctx-size"); if (ci < 0) ci = tk.indexOf("-c")
    const a = ai >= 0 ? tk[ai + 1] : undefined
    const s = ci >= 0 ? tk[ci + 1] : undefined
    if (a && s && /^\d+$/.test(s)) out.push(a + ":" + s)
  }
} catch {}
process.stdout.write(out.join("|"))
' 2>/dev/null)
export DSH_LLAMA_CTX
if [ -n "$DSH_TUI_WORKSPACE" ]; then cd "$DSH_TUI_WORKSPACE"; fi

command -v dsh >/dev/null 2>&1 || {
  echo "[dstm] dsh CLI not found. Install: npm install -g @deepseek-ai/dsh" >&2
  exit 1
}

# Rebuild the positional set without --resume (the for list snapshots "$@"
# before `set --` starts replacing it).
set --
for a in "$@"; do
  if [ "$a" = "--resume" ]; then
    if [ -f "$HOME/.dst-moon/resume.txt" ]; then
      DSH_TUI_RESUME_SESSION=$(cat "$HOME/.dst-moon/resume.txt")
      export DSH_TUI_RESUME_SESSION
    fi
  else
    set -- "$@" "$a"
  fi
done

exec dsh --profile dst-moon "$@"
